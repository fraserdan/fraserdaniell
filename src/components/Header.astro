---
interface Props {
  homeLink?: string;
}
const { homeLink = '/' } = Astro.props;
---
<header>
  <a href={homeLink} class="header-logo">
    <img
      class="logo-desktop"
      src="/images/logo-desktop.svg"
      alt="Fraser Daniell"
      style="width:220px; height:17px; display:block;"
    />
    <img
      class="logo-mobile"
      src="/images/logo-mobile.svg"
      alt="Fraser Daniell"
      style="width:177px; height:16px; display:none;"
    />
  </a>
  <nav></nav>
  <div class="header-right">
    <button class="contact-btn" id="contact-btn">
      <span class="contact-label">Contact</span>
      <span class="copied">Copied</span>
    </button>
  </div>
</header>

<script is:inline>
  document.getElementById('contact-btn').addEventListener('click', function () {
    const btn = this;
    const email = 'fraser.daniell@gmail.com';
    // Fall back to the mail client if the clipboard isn't available
    (navigator.clipboard ? navigator.clipboard.writeText(email) : Promise.reject())
      .then(() => {
        btn.classList.add('show-copied');
        setTimeout(() => btn.classList.remove('show-copied'), 2000);
      })
      .catch(() => { window.location.href = 'mailto:' + email; });
  });
</script>
